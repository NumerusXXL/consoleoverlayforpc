<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: monochrome, the focused thing is the brightest thing on screen. -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="SoftTextBrush" Color="#FFC9D0DE" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FFA3ABBC" />
    <SolidColorBrush x:Key="IconBrush" Color="#FF8A93A6" />
    <SolidColorBrush x:Key="SelectedFillBrush" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#FF0B0E16" />
    <SolidColorBrush x:Key="DimBrush" Color="#80080A10" />
    <SolidColorBrush x:Key="OpaqueBackdropBrush" Color="#FF0B0D12" />
    <SolidColorBrush x:Key="PageBrush" Color="#D110131A" />
    <SolidColorBrush x:Key="DockBrush" Color="#EB14171F" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FocusFillBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TileBrush" Color="#FF262C3A" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFF0A5A5" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- A row in a page list (settings rows, placeholders). Focus = light fill + white outline. -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource FocusFillBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="{StaticResource FocusFillBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A window tile on the All Tabs page. Focus = white outline around the tile. -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource SoftTextBrush}" />
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outline" BorderBrush="Transparent" BorderThickness="2" CornerRadius="17" Padding="3">
                        <Border x:Name="Root" Background="{StaticResource TileBrush}" CornerRadius="14" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF2E3547" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="#FF2E3547" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dock item: an icon, which widens into a light pill with its name when it is the current page.
         Not focusable: pages are switched with LB/RB (or a click), focus stays inside the page. -->
    <Style x:Key="DockButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource IconBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="22" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Selected">
                <Setter Property="Background" Value="{StaticResource SelectedFillBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SelectedTextBrush}" />
                <Setter Property="Padding" Value="14,0,18,0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2,0,0,10" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    </Style>

    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="RowValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RowHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    </Style>

</ResourceDictionary>
