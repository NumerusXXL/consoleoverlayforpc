<Window x:Class="ConsoleOverlay.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console Overlay"
        WindowStyle="None"
        Background="#FF0B0D12"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid x:Name="Root" ClipToBounds="True">
        <!-- A snapshot of the screen taken just before opening, blurred. Opaque fill instead in exclusive fullscreen. -->
        <Rectangle x:Name="OpaqueBackdrop" Fill="{StaticResource OpaqueBackdropBrush}" Visibility="Collapsed" />
        <!-- Sharp first, so opening doesn't jump; the pre-blurred copy fades in over it. No live blur effect:
             a full-screen blur re-rendered every frame is what made page changes stutter. -->
        <Image x:Name="Snapshot" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
        <Image x:Name="SnapshotBlurred" Stretch="Fill" Margin="-40" Opacity="0" RenderOptions.BitmapScalingMode="Linear" />
        <Rectangle x:Name="Dim" Fill="{StaticResource DimBrush}" Opacity="0" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown" />
        <!-- A fixed gradient (cheap: drawn once) so the title, the buttons and the dock stay readable on bright games. -->
        <Rectangle x:Name="Shade" Fill="{StaticResource ShadeBrush}" IsHitTestVisible="False" />

        <!-- Everything you read and press, scaled up as a whole for the TV-distance sizes (Settings › Appearance › Size).
             No background, so clicks on empty space still reach the dim layer and close the overlay. -->
        <Grid x:Name="Chrome">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ChromeScale" />
        </Grid.LayoutTransform>

        <!-- The page: straight on the blurred game, full width, like a console home screen. Title and clock at the
             top, the page's own layout in the middle, button prompts above the dock. -->
        <Grid x:Name="PageCard"
              Margin="64,26,64,0"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PageScale" />
                    <TranslateTransform x:Name="PageOffset" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="TitleOffset" />
                    </StackPanel.RenderTransform>
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="PageSubtitleText" Style="{StaticResource PageSubtitle}" VerticalAlignment="Bottom" Margin="14,0,0,3" />
                </StackPanel>
                <TextBlock x:Name="ClockText" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                           FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="DateText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,14,3"
                           Style="{StaticResource PageSubtitle}" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" x:Name="PageScroller" Margin="0,26,0,0" VerticalScrollBarVisibility="Hidden" Focusable="False">
                <Grid x:Name="PageHost" />
            </ScrollViewer>

            <!-- Button prompts, drawn like a console's: a colored A, a red B, LB / RB pills... Kept small, at the
                 right, just above the dock. -->
            <WrapPanel Grid.Row="2" x:Name="PageHint" HorizontalAlignment="Right" Margin="0,12,0,100" Opacity="0.85" />
        </Grid>

        <!-- Dock -->
        <Border x:Name="Dock"
                Margin="0,0,0,26"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{StaticResource DockBrush}"
                BorderBrush="{StaticResource DockEdgeBrush}"
                BorderThickness="1"
                CornerRadius="30"
                Padding="8"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockOffset" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Border Background="#30FFFFFF" CornerRadius="11" Height="24" Padding="8,0" VerticalAlignment="Center" Margin="8,0,6,0">
                    <TextBlock Text="LB" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </Border>
                <StackPanel x:Name="DockItems" Orientation="Horizontal" />
                <Border Background="#30FFFFFF" CornerRadius="11" Height="24" Padding="8,0" VerticalAlignment="Center" Margin="6,0,8,0">
                    <TextBlock Text="RB" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
