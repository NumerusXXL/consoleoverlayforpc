<Window x:Class="ConsoleOverlay.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <!-- Dims the game behind the panel. Fully opaque in exclusive fullscreen mode. -->
        <Rectangle x:Name="Backdrop" Fill="{StaticResource BackdropBrush}" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown" />

        <Border x:Name="OverlayPanel"
                Width="460"
                Margin="28"
                HorizontalAlignment="Left"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="28,26,28,20"
                RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelOffset" X="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,22">
                    <TextBlock Text="Overlay"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="ModeText"
                               Margin="0,2,0,0"
                               FontSize="13"
                               Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>

                <!-- Tab strip: LB / tabs / RB -->
                <DockPanel Grid.Row="1" Margin="0,0,0,18" LastChildFill="True">
                    <Border DockPanel.Dock="Left" Style="{StaticResource ButtonGlyph}" Margin="0,0,14,6" VerticalAlignment="Center">
                        <TextBlock Text="LB" Style="{StaticResource GlyphText}" />
                    </Border>
                    <Border DockPanel.Dock="Right" Style="{StaticResource ButtonGlyph}" Margin="8,0,0,6" VerticalAlignment="Center">
                        <TextBlock Text="RB" Style="{StaticResource GlyphText}" />
                    </Border>
                    <Grid>
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                        <!-- Accent underline that slides under the selected tab -->
                        <Border x:Name="TabUnderline"
                                Height="3"
                                CornerRadius="1.5"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"
                                Background="{StaticResource AccentBrush}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="UnderlineOffset" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- Tab content -->
                <ScrollViewer Grid.Row="2"
                              x:Name="ContentScroller"
                              VerticalScrollBarVisibility="Hidden"
                              Focusable="False">
                    <Grid x:Name="TabContent" />
                </ScrollViewer>

                <!-- Button hints -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                    <Border Style="{StaticResource ButtonGlyph}">
                        <TextBlock Text="A" Style="{StaticResource GlyphText}" />
                    </Border>
                    <TextBlock Text="Select" Style="{StaticResource HintText}" />
                    <Border Style="{StaticResource ButtonGlyph}">
                        <TextBlock Text="B" Style="{StaticResource GlyphText}" />
                    </Border>
                    <TextBlock Text="Close" Style="{StaticResource HintText}" />
                    <Border Style="{StaticResource ButtonGlyph}">
                        <TextBlock Text="LB RB" Style="{StaticResource GlyphText}" />
                    </Border>
                    <TextBlock Text="Switch tab" Style="{StaticResource HintText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
