<Window x:Class="ConsoleOverlay.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console Overlay"
        WindowStyle="None"
        Background="#FF0B0D12"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid x:Name="Root" ClipToBounds="True">
        <!-- A snapshot of the screen taken just before opening, blurred. Opaque fill instead in exclusive fullscreen. -->
        <Rectangle x:Name="OpaqueBackdrop" Fill="{StaticResource OpaqueBackdropBrush}" Visibility="Collapsed" />
        <!-- Sharp first, so opening doesn't jump; the pre-blurred copy fades in over it. No live blur effect:
             a full-screen blur re-rendered every frame is what made page changes stutter. -->
        <Image x:Name="Snapshot" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
        <Image x:Name="SnapshotBlurred" Stretch="Fill" Margin="-40" Opacity="0" RenderOptions.BitmapScalingMode="Linear" />
        <Rectangle x:Name="Dim" Fill="{StaticResource DimBrush}" Opacity="0" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown" />

        <!-- Everything you read and press, scaled up as a whole for the TV-distance sizes (Settings › Appearance › Size).
             No background, so clicks around the card still reach the dim layer and close the overlay. -->
        <Grid x:Name="Chrome">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="ChromeScale" />
        </Grid.LayoutTransform>

        <!-- Page card: frosted glass. A soft shadow, a see-through tint over the blurred game, a light sheen at the
             top and a hairline edge that is brighter on top, like light catching the rim of a pane. -->
        <Grid x:Name="PageCard"
              Width="880"
              Margin="0,56,0,112"
              HorizontalAlignment="Center"
              Opacity="0"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PageScale" />
                    <TranslateTransform x:Name="PageOffset" />
                </TransformGroup>
            </Grid.RenderTransform>
            <!-- Soft shadow from two faint rings instead of a blur effect (an effect this size costs every frame). -->
            <Border CornerRadius="38" Background="#0C000000" Margin="-12,-8,-12,-16" />
            <Border CornerRadius="32" Background="#16000000" Margin="-6,-3,-6,-9" />
            <Border CornerRadius="26" Background="{StaticResource GlassBrush}" />
            <Border CornerRadius="26" Background="{StaticResource GlassSheenBrush}" />
            <Border CornerRadius="26" BorderBrush="{StaticResource GlassEdgeBrush}" BorderThickness="1" />
            <Grid Margin="32,28,32,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,22" LastChildFill="False">
                    <TextBlock x:Name="PageTitleText" DockPanel.Dock="Left" Style="{StaticResource PageTitle}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleOffset" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="ClockText" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                               FontSize="14" Foreground="{StaticResource SubtleTextBrush}" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <Grid x:Name="PageHost" />
                </ScrollViewer>

                <!-- Button prompts, drawn like a console's: a colored A, a red B, LB / RB pills... -->
                <WrapPanel Grid.Row="2" x:Name="PageHint" Margin="0,16,0,0" />
            </Grid>
        </Grid>

        <!-- Dock -->
        <Border x:Name="Dock"
                Margin="0,0,0,36"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="{StaticResource DockBrush}"
                BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="30"
                Padding="8"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockOffset" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Border Background="#33FFFFFF" CornerRadius="7" Height="24" Padding="8,0" VerticalAlignment="Center" Margin="8,0,6,0">
                    <TextBlock Text="LB" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </Border>
                <StackPanel x:Name="DockItems" Orientation="Horizontal" />
                <Border Background="#33FFFFFF" CornerRadius="7" Height="24" Padding="8,0" VerticalAlignment="Center" Margin="6,0,8,0">
                    <TextBlock Text="RB" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Window>
