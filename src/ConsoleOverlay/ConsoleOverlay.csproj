<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version gives access to Windows Runtime APIs (what is playing, for the Media page).
         It still runs on Windows 10 1809 and later. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon and monitor lookup. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ConsoleOverlay</AssemblyName>
    <RootNamespace>ConsoleOverlay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Release builds take the version from the git tag (v1.2.3). -->
    <Version>1.0.0</Version>
    <!-- Lets the project compile on non-Windows machines (CI, containers). It still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Keep the idle footprint small: one heap. Concurrent (background) collection stays on so a full
         collection never freezes the UI mid-animation; it is what the overlay asks for while open. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- DPI awareness is set in app.manifest, which is right for a WPF app; this WinForms hint does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
    <!-- Microsoft Edge WebView2: the Steam Store, checkout and web chat inside the overlay. Uses the WebView2 Runtime
         that comes with Windows 11 and Edge on Windows 10. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <!-- Encrypts the saved Discord sign-in so only this Windows user can read it. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
