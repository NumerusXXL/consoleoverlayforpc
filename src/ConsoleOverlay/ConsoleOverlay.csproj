<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon and monitor lookup. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ConsoleOverlay</AssemblyName>
    <RootNamespace>ConsoleOverlay</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Release builds take the version from the git tag (v1.2.3). -->
    <Version>1.0.0</Version>
    <!-- Lets the project compile on non-Windows machines (CI, containers). It still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Keep the idle footprint small: one heap. Concurrent (background) collection stays on so a full
         collection never freezes the UI mid-animation; it is what the overlay asks for while open. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- DPI awareness is set in app.manifest, which is right for a WPF app; this WinForms hint does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Encrypts the saved Discord sign-in so only this Windows user can read it. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
